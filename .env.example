# Copy to .env and fill in real values from the Firebase / Google Cloud console.
#
# NOT a secret store. Every value here is compiled into the app and ships to
# end users — anyone can read it out of the web bundle or an APK. These keys
# are safe to expose only because they are restricted in Google Cloud.
# See docs/security.md.
#
# Genuinely secret values belong in Secret Manager. The YouTube Data API key
# lives there and is read only by the Cloud Functions, never by the app:
#   firebase functions:secrets:set YOUTUBE_API_KEY
#
# Read at build time, not runtime:
#   flutter run --dart-define-from-file=.env
#
# To override a value locally, put it in .env.local and pass both files, last
# one winning:
#   flutter run --dart-define-from-file=.env --dart-define-from-file=.env.local

# Firebase API keys, one per platform.
FIREBASE_WEB_API_KEY=
FIREBASE_ANDROID_API_KEY=
FIREBASE_IOS_API_KEY=

# Point the app at `firebase emulators:start` instead of live Firebase.
USE_FIREBASE_EMULATOR=false
